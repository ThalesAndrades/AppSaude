# URL pública do site (sem barra final)
NEXT_PUBLIC_SITE_URL=https://mettafit.site

# Sessão JWT (32+ caracteres aleatórios)
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Rapidoc Telemedicina — Tema v2
RAPIDOC_BASE_URL=
RAPIDOC_API_KEY=
RAPIDOC_PARTNER_ID=
# Aliases aceitos:
# RAPIDOC_URL=
# RAPIDOC_TOKEN=
# CLIENTID=

# Asaas — gateway de pagamentos (Pix + cartão de crédito)
# Chave privada da conta Asaas (começa com $aact_ em produção)
ASAAS_API_KEY=
# Base URL (produção: https://www.asaas.com/api/v3 | sandbox: https://sandbox.asaas.com/api/v3)
ASAAS_BASE_URL=https://www.asaas.com/api/v3

# MongoDB (Atlas)
MONGODB_URI=
MONGODB_DB=mettafit
